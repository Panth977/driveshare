rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every write goes through the functions. The web app only reads what belongs to it.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
      match /private/{doc} {
        allow read, write: if false;
      }
      // Send to TV: an account's own browsers write `now`, its TV reads it. Nothing else.
      match /remote/{doc} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid && doc == 'now'
          && request.resource.data.keys().hasOnly(['kind', 'folderId', 'fileId', 'name', 'nonce', 'at'])
          && request.resource.data.kind in ['folder', 'show', 'file']
          && request.resource.data.folderId is string && request.resource.data.folderId.size() <= 128
          && request.resource.data.name is string && request.resource.data.name.size() <= 300
          && request.resource.data.nonce is string && request.resource.data.nonce.size() <= 40
          && request.resource.data.at == request.time;
      }
    }
    // A TV watches its own sign-in request (the id is a random 20-char key; the doc holds no secret).
    match /tvLogins/{id} {
      allow get: if resource.data.expiresAt > request.time;
      allow list, write: if false;
    }
    match /shares/{shareId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
      match /{sub}/{id} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/shares/$(shareId)).data.ownerUid == request.auth.uid;
        allow write: if false;
      }
    }
  }
}
